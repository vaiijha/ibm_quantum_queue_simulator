# IBM Quantum Platform API key (44-char key from dashboard — NOT a bearer token)
IBM_QUANTUM_API_KEY=your_api_key_here

# Instance CRN from Instances page (strongly recommended)
IBM_INSTANCE_CRN=crn:v1:bluemix:public:quantum-computing:us-east:a/...

# Channel (default: ibm_quantum_platform)
# IBM_QUANTUM_CHANNEL=ibm_quantum_platform

LOG_DIR=./logs
RUNS_PER_DAY=288
ENABLE_JOB_PROBES=false
PROBE_EVERY_N_TICKS=6
PROBE_SHOTS=100
JOB_POLL_INTERVAL_SECONDS=15
BACKEND_STATUS_DELAY_SECONDS=0.5
API_MAX_RETRIES=3
API_RETRY_BASE_SECONDS=2
